# Python virtual environments (one per lab, created by `uv sync`)
.venv
.venv/

# uv lockfiles are intentionally not committed: labs pin ranges in
# pyproject.toml and are meant to resolve fresh.
uv.lock

# Python bytecode
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# Scraper working data
scraper
.playwright-cli

# ── Artifacts produced by running the labs ───────────────────────────────────
# Running a notebook should not dirty the working tree. Everything below is
# generated on demand and regenerated the next time you run that lab.

# Kubernetes lab: notebooks %%writefile their manifests next to themselves.
# The curated, checked-in manifests live in kubernetes/manifests/ instead.
03-technologies/container-orchestration/kubernetes/notebooks/*.yaml
03-technologies/container-orchestration/kubernetes/notebooks/helm-lab/
03-technologies/container-orchestration/kubernetes/notebooks/kustomize-lab/

# CDN lab: the push-CDN and stale-content demos write files the origin serves.
01-foundations/cdn/edge/edge1_pushed/*
01-foundations/cdn/edge/edge2_pushed/*
!01-foundations/cdn/edge/edge*_pushed/.gitkeep
01-foundations/cdn/origin/assets/stale_demo.txt

# Networking lab: self-signed certs, regenerated by nginx/generate_certs.sh
01-foundations/networking-essentials/nginx/certs/

# Notebook 08 of the Kubernetes lab downloads and unpacks an Istio release
# (~100 MB) next to the notebooks. It is a downloaded artifact, not source.
03-technologies/container-orchestration/kubernetes/notebooks/istio-*/
