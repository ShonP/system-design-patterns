# Copy to .env (docker-compose picks it up automatically)
# These match the pre-seeded app registrations in fake-entra/apps.json.

TENANT_ID=contoso
AUTHORITY=http://localhost:9000/contoso
ISSUER=http://localhost:9000/contoso/v2.0
JWKS_URI=http://localhost:9000/contoso/discovery/v2.0/keys

# API-A (middle tier) app registration
API_A_CLIENT_ID=api-a-client-id
API_A_CLIENT_SECRET=api-a-secret-value
API_A_AUDIENCE=api://api-a

# API-B (resource) app registration
API_B_CLIENT_ID=api-b-client-id
API_B_CLIENT_SECRET=api-b-secret-value
API_B_AUDIENCE=api://api-b

# Daemon caller
DAEMON_CLIENT_ID=daemon-client-id
DAEMON_CLIENT_SECRET=daemon-secret-value
